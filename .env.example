# Copy to a private .env (gitignored). Never commit real values.
# Native / API process
FORGE_DATABASE_URL=
FORGE_OIDC_ISSUER=
FORGE_OIDC_AUDIENCE=
FORGE_HTTP_ADDR=127.0.0.1:8081

# Worker only — free OpenRouter route; no paid fallback
FORGE_MODEL_API_KEY=
FORGE_MODEL_FIXTURE=true

# Tests (disposable admin URL only)
FORGE_TEST_ADMIN_DATABASE_URL=
FORGE_REQUIRE_DB_TESTS=0

# Optional supply-chain (leave unset when tools/images are absent)
FORGE_IMAGE=
FORGE_COSIGN_KEY=
FORGE_FAILURE_OUTPUT=
